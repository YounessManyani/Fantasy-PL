{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",           // ✅ ou "Node16"
      "lib": ["ES2022"],
      "moduleResolution": "Node16", // ✅ ou "NodeNext"
      "rootDir": "./src",
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "declaration": true,
      "sourceMap": true,
      "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
  }