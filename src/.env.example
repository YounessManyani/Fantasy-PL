# .env.example - Copy to .env and fill in your values

# Server Configuration
PORT=8000
NODE_ENV=development

# Data Configuration
CSV_PATH=./data/fpl_player_statistics.csv

# LLM Configuration
USE_LLM=0                           # Set to 1 to enable LLM name resolution
LLM_PROVIDER=openai                 # Options: openai, ollama
LLM_MODEL=gpt-4o-mini              # Model to use
LLM_TIMEOUT=120000                  # Timeout in milliseconds
LLM_MAX_TOKENS=400                  # Max tokens for response

# API Keys (required if USE_LLM=1)
OPENAI_API_KEY=                     # Your OpenAI API key

# CORS Configuration (optional)
CORS_ORIGIN=*                       # Allowed origins for CORS